{
  "name": "vxv",
  "private": true,
  "description": "VXV guild tool for WoW Forever: addon, website, Discord bot and companion app.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "supabase",
    "tools/addon-release",
    "tools/data-generator",
    "tools/probe-harness"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "export:probe": "npm run export -w @vxv/probe-harness --",
    "generate": "npm run generate -w @vxv/data-generator",
    "release:prepare": "npm run prepare-release -w @vxv/addon-release --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  }
}
