{
  "name": "vxv",
  "private": true,
  "description": "VXV guild tool for WoW Forever: addon, website, Discord bot and companion app.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/probe-harness"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "npm test --workspaces --if-present",
    "export:probe": "npm run export -w @vxv/probe-harness --"
  }
}
