{
  "name": "@vxv/data-generator",
  "private": true,
  "description": "Generates the addon data packs and the database sync script from data/raids.",
  "type": "module",
  "exports": {
    "./seedSql": "./src/seedSql.ts"
  },
  "scripts": {
    "generate": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --maxWorkers=2 --hookTimeout=30000 --testTimeout=30000"
  },
  "dependencies": {
    "@vxv/lua": "*",
    "@vxv/raid-data": "*"
  },
  "devDependencies": {
    "@vxv/database": "*"
  }
}
