{
  "name": "@vxv/companion",
  "productName": "VXV Compagnon",
  "private": true,
  "version": "0.0.0",
  "description": "VXV companion: desktop app linking the game to the website (Windows and Mac).",
  "author": "VXV",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsx build.ts",
    "start": "tsx build.ts && electron .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "package": "tsx build.ts && electron-builder --publish never"
  },
  "devDependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@vxv/design": "*",
    "@vxv/lua": "*",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2"
  }
}
