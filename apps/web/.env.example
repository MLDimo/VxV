# Copy to apps/web/.env.local for local development. Never commit real values.

# Supabase "Transaction pooler" connection string (port 6543) of the test database.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# Public address of the website, used in the links of the bot's messages.
SITE_URL=http://localhost:3000
# Random secret (32 characters or more) that Vercel sends to the scheduled tasks (apps/web/vercel.json).
CRON_SECRET=

# Discord application (Developer Portal, OAuth2 page). Redirect URI to register:
# http://localhost:3000/connexion/discord/retour
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# General information page: public key, checks that interactions come from Discord.
DISCORD_PUBLIC_KEY=
# Bot page: the bot's token (secret), to rename members and manage roles and messages.
DISCORD_BOT_TOKEN=

# Guild Discord server (everybody on it is a member) and the roles above member (right click, "Copy ID").
DISCORD_GUILD_ID=
# Channel of the bot's /vxv_main and /vxv_reroll commands.
DISCORD_LINK_CHANNEL_ID=
# Channel where the bot publishes each event's sign-up message.
DISCORD_RAID_CHANNEL_ID=
# Optional, hence commented out (the CI requires every other variable on Vercel): channel where the bot publishes
# each bet, the raid channel otherwise.
# DISCORD_BETS_CHANNEL_ID=
# Optional too: channel where the bot publishes each mission, the raid channel otherwise.
# DISCORD_MISSIONS_CHANNEL_ID=
# Optional too: channel where the bot announces each week's titles, the raid channel otherwise.
# DISCORD_TITLES_CHANNEL_ID=
# Optional too: channel of the PvP outings' sign-up messages and of the duels, the raid channel otherwise.
# DISCORD_PVP_CHANNEL_ID=
DISCORD_ROLE_TREASURER=
DISCORD_ROLE_OFFICER=
DISCORD_ROLE_GM=
