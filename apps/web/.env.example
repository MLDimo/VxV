# Copy to apps/web/.env.local for local development. Never commit real values.

# Supabase "Transaction pooler" connection string (port 6543) of the test database.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# Discord application (Developer Portal, OAuth2 page). Redirect URI to register:
# http://localhost:3000/connexion/discord/retour
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Guild Discord server (everybody on it is a member) and the roles above member (right click, "Copy ID").
DISCORD_GUILD_ID=
DISCORD_ROLE_TREASURER=
DISCORD_ROLE_OFFICER=
DISCORD_ROLE_GM=
