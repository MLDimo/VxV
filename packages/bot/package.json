{
  "name": "@vxv/bot",
  "private": true,
  "description": "Discord bot over HTTP interactions: signature check, slash commands and buttons, on top of @vxv/server.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --maxWorkers=2 --hookTimeout=30000 --testTimeout=30000",
    "register-commands": "tsx src/registerCommands.ts",
    "upload-emojis": "tsx src/uploadEmojis.ts"
  },
  "dependencies": {
    "@vxv/server": "*",
    "discord-api-types": "^0.38.56"
  },
  "devDependencies": {
    "@vxv/database": "*"
  }
}
